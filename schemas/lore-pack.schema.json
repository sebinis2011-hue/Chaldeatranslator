{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaldeatranslator.local/schemas/lore-pack.schema.json",
  "title": "ChaldeaTranslator Lore Pack",
  "type": "object",
  "required": ["schema_version", "pack_id", "language", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string" },
    "status": { "enum": ["seed", "reviewed", "release"] },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "summary", "certainty", "continuity", "source_ids"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["concept", "rule", "character", "work", "place", "organization", "object", "event"] },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "certainty": { "enum": ["CANON_PRIMARY", "CANON_SECONDARY", "REFERENCE_COMPILATION", "INFERENCE", "FANON", "USER_AU", "UNKNOWN_CONFLICT"] },
          "continuity": { "type": "string" },
          "work_scope": { "type": "array", "items": { "type": "string" } },
          "conditions": { "type": "array", "items": { "type": "string" } },
          "exceptions": { "type": "array", "items": { "type": "string" } },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "related_ids": { "type": "array", "items": { "type": "string" } }
        },
        "allOf": [
          {
            "if": { "properties": { "certainty": { "enum": ["CANON_PRIMARY", "CANON_SECONDARY", "REFERENCE_COMPILATION"] } } },
            "then": { "properties": { "source_ids": { "minItems": 1 } } }
          }
        ]
      }
    }
  }
}
